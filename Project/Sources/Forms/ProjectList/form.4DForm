{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 680,
	"windowMinHeight": 0,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onDoubleClick",
		"onTimer"
	],
	"windowTitle": ":xliff:ProjectList_WindowTitle",
	"destination": "detailScreen",
	"pages": [
		{
			"objects": {
				"ToolbarBg": {
					"type": "rectangle",
					"top": 20,
					"left": 20,
					"width": 640,
					"height": 46,
					"class": "toolbar-surface",
					"sizingX": "grow"
				},
				"bEdit": {
					"type": "button",
					"text": "",
					"top": 27,
					"left": 90,
					"width": 38,
					"height": 32,
					"icon": "/RESOURCES/Images/Buttons/Edit.png",
					"events": [
						"onClick"
					],
					"class": "toolbar-button",
					"method": "ObjectMethods/bEdit.4dm",
					"tooltip": ":xliff:Toolbar_EditProject"
				},
				"bAdd": {
					"type": "button",
					"text": "",
					"top": 27,
					"left": 130,
					"width": 38,
					"height": 32,
					"icon": "/RESOURCES/Images/Buttons/Add.png",
					"events": [
						"onClick"
					],
					"class": "toolbar-button",
					"method": "ObjectMethods/bAdd.4dm",
					"tooltip": ":xliff:Toolbar_AddProject"
				},
				"bDrop": {
					"type": "button",
					"text": "",
					"top": 27,
					"left": 170,
					"width": 38,
					"height": 32,
					"icon": "/RESOURCES/Images/Buttons/Delete.png",
					"events": [
						"onClick"
					],
					"class": "toolbar-button",
					"method": "ObjectMethods/bDrop.4dm",
					"tooltip": ":xliff:Toolbar_DeleteProject"
				},
				"bPrint": {
					"type": "button",
					"text": "",
					"top": 27,
					"left": 612,
					"width": 38,
					"height": 32,
					"sizingX": "move",
					"icon": "/RESOURCES/Images/Buttons/Print.png",
					"events": [
						"onClick"
					],
					"class": "toolbar-button",
					"method": "ObjectMethods/bPrint.4dm",
					"tooltip": ":xliff:Toolbar_Print"
				},
				"Input": {
					"type": "input",
					"left": 394,
					"top": 32,
					"width": 208,
					"height": 22,
					"verticalAlign": "middle",
					"paddingRight": 46,
					"dataSource": "Form:C1466.search",
					"sizingX": "move",
					"events": [
						"onLosingFocus",
						"onBeforeKeystroke",
						"onAfterKeystroke"
					],
					"method": "ObjectMethods/Input.4dm",
					"placeholder": ":xliff:Toolbar_SearchPlaceholder",
					"paddingBottom": 2
				},
				"btnDel": {
					"type": "button",
					"top": 33,
					"left": 559,
					"width": 20,
					"height": 20,
					"events": [
						"onClick"
					],
					"style": "custom",
					"icon": "/RESOURCES/Images/Buttons/ClearSearch.png",
					"iconFrames": 4,
					"sizingX": "move",
					"method": "ObjectMethods/btnDel.4dm"
				},
				"btnSearch": {
					"type": "button",
					"top": 33,
					"left": 581,
					"width": 20,
					"height": 20,
					"events": [
						"onClick"
					],
					"style": "custom",
					"icon": "/RESOURCES/Images/Buttons/Search.png",
					"iconFrames": 4,
					"sizingX": "move",
					"method": "ObjectMethods/btnSearch.4dm",
					"shortcutAccel": false,
					"shortcutControl": false,
					"shortcutShift": false,
					"shortcutAlt": false,
					"shortcutKey": "[Return]"
				},
				"bEdit1": {
					"type": "button",
					"text": "",
					"top": 27,
					"left": 30,
					"width": 38,
					"height": 34,
					"icon": "/RESOURCES/Images/Buttons/Back.png",
					"events": [
						"onClick"
					],
					"class": "toolbar-button",
					"tooltip": ":xliff:Toolbar_Back",
					"action": "cancel"
				}
			},
			"entryOrder": [
				"bEdit",
				"bAdd",
				"bDrop",
				"bPrint",
				"Input",
				"btnSearch",
				"btnDel",
				"bEdit1"
			]
		},
		{
			"objects": {
				"ListBox": {
					"type": "listbox",
					"left": 20,
					"top": 86,
					"width": 640,
					"height": 341,
					"events": [
						"onClick",
						"onSelectionChange",
						"onHeaderClick"
					],
					"listboxType": "collection",
					"dataSource": "Form:C1466.projects",
					"sizingX": "grow",
					"sizingY": "grow",
					"hideFocusRing": true,
					"selectionMode": "single",
					"currentItemSource": "Form:C1466.selectedProject",
					"scrollbarHorizontal": "automatic",
					"scrollbarVertical": "automatic",
					"class": "data-grid",
					"columns": [
						{
							"header": {
								"text": ":xliff:Label_Name",
								"name": "Header1",
								"class": "data-grid-header"
							},
							"name": "Column1",
							"footer": {
								"name": "Footer1",
								"truncateMode": "none"
							},
							"dataSource": "This:C1470.name",
							"minWidth": 200,
							"maxWidth": 300,
							"width": 260,
							"truncateMode": "none"
						},
						{
							"header": {
								"name": "Header2",
								"text": ":xliff:Label_Manager",
								"class": "data-grid-header"
							},
							"name": "Column2",
							"footer": {
								"name": "Footer2",
								"truncateMode": "none"
							},
							"dataSource": "This:C1470.manager",
							"minWidth": 100,
							"maxWidth": 300,
							"width": 110,
							"truncateMode": "none"
						},
						{
							"header": {
								"name": "Header4",
								"text": ":xliff:Label_Status",
								"class": "data-grid-header"
							},
							"name": "Column4",
							"dataSource": "This:C1470.statusLabel",
							"footer": {
								"name": "Footer4",
								"truncateMode": "none"
							},
							"width": 90,
							"minWidth": 90,
							"maxWidth": 120,
							"truncateMode": "none"
						},
						{
							"header": {
								"name": "Header5",
								"text": ":xliff:Label_Progress",
								"class": "data-grid-header"
							},
							"name": "Column5",
							"dataSource": "This:C1470.progress",
							"dataSourceTypeHint": "number",
							"footer": {
								"name": "Footer5",
								"truncateMode": "none"
							},
							"numberFormat": "##0%",
							"width": 70,
							"enterable": false,
							"minWidth": 70,
							"maxWidth": 70,
							"truncateMode": "none"
						},
						{
							"header": {
								"name": "Header3",
								"text": ":xliff:Label_Validation",
								"class": "data-grid-header"
							},
							"name": "Column3",
							"footer": {
								"name": "Footer3",
								"truncateMode": "none"
							},
							"dataSource": "This:C1470.clientValidationRequired",
							"dataSourceTypeHint": "boolean",
							"textAlign": "center",
							"width": 80,
							"minWidth": 80,
							"maxWidth": 80,
							"truncateMode": "none"
						}
					],
					"resizingMode": "legacy"
				}
			}
		}
	],
	"geometryStamp": 1192,
	"method": "method.4dm",
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"formClass": "ProjectListForm",
	"rightMargin": 20,
	"bottomMargin": 20
}